OPENAI_API_KEY=your-openai-api-key
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# Recommended for a public deployment. Leave empty for local development.
APP_ACCESS_KEY=choose-a-private-passphrase

# Any CrewAI-supported model can be used here.
LLM_MODEL=openai/gpt-4.1-mini

# Avoid an interactive tracing prompt on a web server. Set to true if wanted.
CREWAI_TRACING_ENABLED=false
